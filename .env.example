# Email Configuration
# Fill in your real credentials here. This file is ignored by Git.

EMAIL_SMTP_SERVER="you_smtp_address"
EMAIL_SMTP_PORT="ssl_port"
EMAIL_SENDER="your_email@qq.com"
EMAIL_PASSWORD="your_smtp_authorization_code"
EMAIL_RECEIVER="your_receiver_email@qq.com"

# The same EMAIL_* block above is reused by backup_to_baidu.py for
# backup result notifications.

# Baidu Pan Backup Configuration
# Register at https://pan.baidu.com/union/home to get these credentials
BAIDU_APP_KEY="your_app_key"
BAIDU_APP_SECRET="your_app_secret"
BAIDU_REFRESH_TOKEN="your_refresh_token"
BAIDU_BACKUP_DIR="/apps/your_appliction_name"
